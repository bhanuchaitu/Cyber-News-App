# Cyber News App - Environment Configuration
# Copy this file to .env and fill in your Supabase values.

SUPABASE_URL=https://your-project-id.supabase.co
SUPABASE_KEY=your_supabase_anon_key_here
SUPABASE_SERVICE_ROLE_KEY=your_server_only_service_role_key_here

# Frontend-style aliases are also supported if you already have them:
# NEXT_PUBLIC_SUPABASE_URL=https://your-project-id.supabase.co
# NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=your_supabase_publishable_or_anon_key_here

# Optional collector tuning
MAX_ITEMS_PER_SOURCE=15
NVD_DELAY_SECONDS=2

# Watchlist and noise filters are intentionally kept in code for now
# so the app stays simple and predictable.
